datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  CASHIER
}

enum ItemType {
  KITCHEN
  PACKED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OrderStatus {
  DRAFT
  PAID
  PRINTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PRINT
  CANCEL
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(100)
  username      String         @unique @db.VarChar(50)
  email         String         @unique @db.VarChar(100)
  phone         String?        @db.VarChar(20)
  password      String         @db.VarChar(255)
  roleId        String         @db.Uuid
  status        String         @default("ACTIVE") @db.VarChar(20)
  profileImage  String?        @db.VarChar(255)
  terminalId    String?        @db.Uuid
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  role          Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  terminal      Terminal?      @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  orders        Order[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  userSessions  UserSession[]
  cashierShifts CashierShift[]

  @@index([username])
  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @unique @db.VarChar(100)
  description  String?    @db.VarChar(255)
  displayOrder Int        @default(0)
  status       String     @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  menuItems    MenuItem[]

  @@index([name])
  @@index([createdAt])
  @@map("categories")
}

model MenuItem {
  id          String      @id @default(uuid()) @db.Uuid
  categoryId  String      @db.Uuid
  name        String      @db.VarChar(100)
  description String?     @db.VarChar(255)
  price       Decimal     @db.Decimal(10, 2)
  gst         Decimal     @default(5.00) @db.Decimal(5, 2)
  itemType    ItemType
  image       String?     @db.VarChar(255)
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([name])
  @@index([createdAt])
  @@map("menu_items")
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  tokenNumber    String        @db.VarChar(10)
  orderNumber    String        @unique @db.VarChar(50)
  cashierId      String        @db.Uuid
  businessDayId  String?       @db.Uuid
  cashierShiftId String?       @db.Uuid
  subtotal       Decimal       @db.Decimal(10, 2)
  gstAmount      Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0.00) @db.Decimal(10, 2)
  grandTotal     Decimal       @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(PENDING)
  orderStatus    OrderStatus   @default(DRAFT)
  businessDate   DateTime      @db.Date
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?
  cancelledAt    DateTime?
  customerId     String?       @db.Uuid
  cashier        User          @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  businessDay    BusinessDay?  @relation(fields: [businessDayId], references: [id], onDelete: Restrict)
  cashierShift   CashierShift? @relation(fields: [cashierShiftId], references: [id], onDelete: Restrict)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  payment        Payment?

  @@unique([tokenNumber, businessDate])
  @@index([orderNumber])
  @@index([tokenNumber])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([businessDate])
  @@index([createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  menuItemId String   @db.Uuid
  itemName   String   @db.VarChar(100)
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  gst        Decimal  @db.Decimal(5, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  itemType   ItemType
  notes      String?  @db.VarChar(255)
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuItemId])
  @@index([createdAt])
  @@map("order_items")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @unique @db.Uuid
  paymentMethod        PaymentMethod
  amount               Decimal       @db.Decimal(10, 2)
  transactionReference String?       @db.VarChar(100)
  status               PaymentStatus @default(PENDING)
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model RestaurantSettings {
  id             String   @id @default(uuid()) @db.Uuid
  restaurantName String   @db.VarChar(100)
  address        String   @db.VarChar(255)
  phone          String   @db.VarChar(20)
  email          String   @db.VarChar(100)
  gstNumber      String   @db.VarChar(20)
  currency       String   @default("INR") @db.VarChar(10)
  timezone       String   @default("Asia/Kolkata") @db.VarChar(50)
  logo           String?  @db.VarChar(255)
  receiptFooter  String?  @db.VarChar(255)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("restaurant_settings")
}

model TokenCounter {
  id           String   @id @default(uuid()) @db.Uuid
  businessDate DateTime @unique @db.Date
  currentToken Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessDate])
  @@map("token_counters")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @db.Uuid
  action      AuditAction
  entity      String      @db.VarChar(50)
  entityId    String?     @db.VarChar(50)
  description String      @db.VarChar(255)
  ipAddress   String?     @db.VarChar(45)
  userAgent   String?     @db.VarChar(255)
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  token      String    @unique
  deviceName String?   @db.VarChar(100)
  browser    String?   @db.VarChar(100)
  ipAddress  String?   @db.VarChar(45)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  loginTime       DateTime  @default(now())
  logoutTime      DateTime?
  device          String?   @db.VarChar(100)
  browser         String?   @db.VarChar(100)
  operatingSystem String?   @db.VarChar(100)
  ipAddress       String?   @db.VarChar(45)
  status          String    @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("user_sessions")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  username      String   @db.VarChar(50)
  ipAddress     String   @db.VarChar(45)
  status        String   @db.VarChar(20)
  failureReason String?  @db.VarChar(255)
  createdAt     DateTime @default(now())

  @@index([username])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

model Terminal {
  id               String         @id @default(uuid()) @db.Uuid
  terminalCode     String         @unique @db.VarChar(50)
  terminalName     String         @db.VarChar(100)
  location         String?        @db.VarChar(100)
  deviceId         String?        @db.VarChar(100)
  status           String         @default("OFFLINE") @db.VarChar(20) // ONLINE, OFFLINE, BUSY
  lastHeartbeat    DateTime?
  receiptPrinterId String?        @db.Uuid
  kitchenPrinterId String?        @db.Uuid
  backupPrinterId  String?        @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  shifts           CashierShift[]
  cashDrawer       CashDrawer?
  receiptPrinter   Printer?       @relation("ReceiptPrinter", fields: [receiptPrinterId], references: [id], onDelete: SetNull)
  kitchenPrinter   Printer?       @relation("KitchenPrinter", fields: [kitchenPrinterId], references: [id], onDelete: SetNull)
  backupPrinter    Printer?       @relation("BackupPrinter", fields: [backupPrinterId], references: [id], onDelete: SetNull)
  users            User[]

  @@map("terminals")
}

model CashierShift {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  terminalId     String       @db.Uuid
  businessDayId  String?      @db.Uuid
  openingTime    DateTime     @default(now())
  closingTime    DateTime?
  openingCash    Decimal      @db.Decimal(10, 2)
  closingCash    Decimal?     @db.Decimal(10, 2)
  cashDifference Decimal?     @db.Decimal(10, 2)
  status         String       @default("OPEN") @db.VarChar(20) // OPEN, CLOSED
  notes          String?      @db.VarChar(255)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  terminal       Terminal     @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  businessDay    BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: Restrict)
  cashDrawer     CashDrawer?
  orders         Order[]

  @@map("cashier_shifts")
}

model BusinessDay {
  id           String         @id @default(uuid()) @db.Uuid
  businessDate DateTime       @unique @db.Date
  openedBy     String         @db.Uuid
  closedBy     String?        @db.Uuid
  openedAt     DateTime       @default(now())
  closedAt     DateTime?
  status       String         @default("OPEN") @db.VarChar(20) // OPEN, CLOSED
  orders       Order[]
  shifts       CashierShift[]

  @@map("business_days")
}

model Printer {
  id              String     @id @default(uuid()) @db.Uuid
  name            String     @db.VarChar(100)
  type            String     @db.VarChar(50) 
  brand           String?    @db.VarChar(50)
  model           String?    @db.VarChar(50)
  connectionType  String     @db.VarChar(20)
  ipAddress       String?    @db.VarChar(45)
  port            Int?       @default(9100)
  paperWidth      String     @default("80mm") @db.VarChar(10)
  location        String     @db.VarChar(100)
  terminalId      String?    @db.Uuid
  status          String     @default("ONLINE") @db.VarChar(20)
  autoPrint       Boolean    @default(true)
  printReceipt    Boolean    @default(true)
  printKOT        Boolean    @default(true)
  printInvoice    Boolean    @default(false)
  notes           String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  receiptTerminal Terminal[] @relation("ReceiptPrinter")
  kitchenTerminal Terminal[] @relation("KitchenPrinter")
  backupTerminal  Terminal[] @relation("BackupPrinter")

  @@map("printers")
}

model CashDrawer {
  id                     String            @id @default(uuid()) @db.Uuid
  terminalId             String            @unique @db.Uuid
  cashierShiftId         String?           @unique @db.Uuid
  drawerCode             String            @unique @db.VarChar(50)
  openingBalance         Decimal           @db.Decimal(10, 2)
  currentBalance         Decimal           @db.Decimal(10, 2)
  expectedClosingBalance Decimal           @db.Decimal(10, 2)
  actualClosingBalance   Decimal?          @db.Decimal(10, 2)
  difference             Decimal?          @db.Decimal(10, 2)
  status                 String            @default("CLOSED") @db.VarChar(20) // OPEN, CLOSED, LOCKED
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  terminal               Terminal          @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  cashierShift           CashierShift?     @relation(fields: [cashierShiftId], references: [id], onDelete: SetNull)
  events                 CashDrawerEvent[]

  @@map("cash_drawers")
}

model CashDrawerEvent {
  id           String     @id @default(uuid()) @db.Uuid
  cashDrawerId String     @db.Uuid
  userId       String?    @db.Uuid
  eventType    String     @db.VarChar(50) // OPEN, CLOSE, MANUAL_OPEN, ADD_CASH, REMOVE_CASH
  amount       Decimal?   @db.Decimal(10, 2)
  reason       String?    @db.VarChar(255)
  createdAt    DateTime   @default(now())
  cashDrawer   CashDrawer @relation(fields: [cashDrawerId], references: [id], onDelete: Cascade)

  @@index([cashDrawerId])
  @@map("cash_drawer_events")
}

// ==========================================
// INVENTORY MODULE
// ==========================================

model InventoryCategory {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(100)
  description String?      @db.VarChar(255)
  color       String?      @db.VarChar(20)
  status      String       @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  ingredients Ingredient[]

  @@map("inventory_categories")
}

model Vendor {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(100)
  contactPerson  String?         @db.VarChar(100)
  email          String?         @db.VarChar(100)
  phone          String?         @db.VarChar(20)
  gstNumber      String?         @db.VarChar(50)
  address        String?         @db.VarChar(255)
  status         String          @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("vendors")
}

model Ingredient {
  id            String            @id @default(uuid()) @db.Uuid
  categoryId    String            @db.Uuid
  name          String            @unique @db.VarChar(100)
  sku           String            @unique @db.VarChar(50)
  barcode       String?           @unique @db.VarChar(100)
  unit          String            @db.VarChar(20)
  currentStock  Decimal           @default(0.00) @db.Decimal(10, 3)
  minStock      Decimal           @default(0.00) @db.Decimal(10, 3)
  maxStock      Decimal?          @db.Decimal(10, 3)
  reorderLevel  Decimal?          @db.Decimal(10, 3)
  costPerUnit   Decimal           @default(0.00) @db.Decimal(10, 2)
  image         String?           @db.VarChar(255)
  status        String            @default("ACTIVE") @db.VarChar(20)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  category      InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements     StockMovement[]
  purchaseItems PurchaseItem[]

  @@index([categoryId])
  @@index([name])
  @@map("ingredients")
}

model PurchaseOrder {
  id           String         @id @default(uuid()) @db.Uuid
  poNumber     String         @unique @db.VarChar(50)
  vendorId     String         @db.Uuid
  status       String         @default("PENDING") @db.VarChar(20) // PENDING, RECEIVED, CANCELLED
  totalAmount  Decimal        @default(0.00) @db.Decimal(12, 2)
  expectedDate DateTime?      @db.Date
  receivedDate DateTime?      @db.Date
  notes        String?        @db.VarChar(255)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  vendor       Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items        PurchaseItem[]

  @@index([vendorId])
  @@index([poNumber])
  @@map("purchase_orders")
}

model PurchaseItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  ingredientId    String        @db.Uuid
  quantity        Decimal       @db.Decimal(10, 3)
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([ingredientId])
  @@map("purchase_items")
}

model StockMovement {
  id           String     @id @default(uuid()) @db.Uuid
  ingredientId String     @db.Uuid
  type         String     @db.VarChar(20) // IN, OUT, ADJUST, WASTE, SALE
  quantity     Decimal    @db.Decimal(10, 3)
  reason       String?    @db.VarChar(255)
  referenceId  String?    @db.VarChar(50) // PO number or Order ID
  createdAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([ingredientId])
  @@index([type])
  @@map("stock_movements")
}

// ==========================================
// CUSTOMER & LOYALTY MODULE
// ==========================================

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  mobileNumber String    @unique @db.VarChar(20)
  email        String?   @db.VarChar(100)
  dateOfBirth  DateTime? @db.Date
  anniversary  DateTime? @db.Date
  gender       String?   @db.VarChar(20)
  address      String?   @db.VarChar(255)
  gstNumber    String?   @db.VarChar(50)
  status       String    @default("ACTIVE") @db.VarChar(20)
  notes        String?   @db.VarChar(255)

  // Loyalty
  totalPoints Decimal @default(0.00) @db.Decimal(10, 2)
  rewardTier  String  @default("BRONZE") @db.VarChar(20) // BRONZE, SILVER, GOLD, PLATINUM

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orders       Order[]
  transactions LoyaltyTransaction[]

  @@index([mobileNumber])
  @@index([name])
  @@map("customers")
}

model LoyaltyTransaction {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  orderId    String?  @db.VarChar(50) // Reference to order, not strictly foreign key to avoid circular/cascade issues
  type       String   @db.VarChar(20) // EARN, REDEEM, EXPIRE, CLAWBACK
  points     Decimal  @db.Decimal(10, 2)
  reason     String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([type])
  @@map("loyalty_transactions")
}

// ==========================================
// NOTIFICATIONS MODULE
// ==========================================

model Notification {
  id       String @id @default(uuid()) @db.Uuid
  title    String @db.VarChar(150)
  message  String @db.Text
  type     String @db.VarChar(50) // SYSTEM, INVENTORY, KITCHEN, SHIFT
  priority String @default("MEDIUM") @db.VarChar(20) // CRITICAL, HIGH, MEDIUM, LOW

  // Targeting
  userId String? @db.Uuid
  roleId String? @db.Uuid // Broadcaster for specific roles

  isRead     Boolean @default(false)
  isArchived Boolean @default(false)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([roleId])
  @@index([isRead])
  @@map("notifications")
}

model NotificationPreference {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @db.Uuid
  receiveSystem    Boolean @default(true)
  receiveInventory Boolean @default(true)
  receiveKitchen   Boolean @default(true)
  receiveShift     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@map("notification_preferences")
}

// ==========================================
// SYSTEM ADMINISTRATION MODULE
// ==========================================

model SystemBackup {
  id        String   @id @default(uuid()) @db.Uuid
  filename  String   @db.VarChar(255)
  filePath  String   @db.VarChar(500)
  fileSize  BigInt?
  status    String   @default("PENDING") @db.VarChar(20) // PENDING, COMPLETED, FAILED
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("system_backups")
}

model LicenseKey {
  id          String    @id @default(uuid()) @db.Uuid
  licenseKey  String    @unique @db.VarChar(255)
  status      String    @default("INACTIVE") @db.VarChar(20) // ACTIVE, INACTIVE, EXPIRED
  features    String?   @db.Text // JSON string of enabled features
  expiresAt   DateTime?
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("license_keys")
}
