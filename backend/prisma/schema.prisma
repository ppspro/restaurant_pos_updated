generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(100)
  username      String         @unique @db.VarChar(50)
  email         String         @unique @db.VarChar(100)
  phone         String?        @db.VarChar(20)
  password      String         @db.VarChar(255)
  roleId        String         @db.Uuid
  status        String         @default("ACTIVE") @db.VarChar(20)
  profileImage  String?        @db.VarChar(255)
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  auditLogs     AuditLog[]
  cashierShifts CashierShift[]
  orders        Order[]
  refreshTokens RefreshToken[]
  userSessions  UserSession[]
  role          Role           @relation(fields: [roleId], references: [id])

  @@index([username])
  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @unique @db.VarChar(100)
  description  String?    @db.VarChar(255)
  displayOrder Int        @default(0)
  status       String     @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  menuItems    MenuItem[]

  @@index([name])
  @@index([createdAt])
  @@map("categories")
}

model MenuItem {
  id          String      @id @default(uuid()) @db.Uuid
  categoryId  String      @db.Uuid
  name        String      @db.VarChar(100)
  description String?     @db.VarChar(255)
  price       Decimal     @db.Decimal(10, 2)
  gst         Decimal     @default(5.00) @db.Decimal(5, 2)
  itemType    ItemType
  image       String?     @db.VarChar(255)
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  itemNumber  String      @unique @db.VarChar(50)
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([name])
  @@index([createdAt])
  @@map("menu_items")
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  tokenNumber    String        @db.VarChar(10)
  orderNumber    String        @unique @db.VarChar(50)
  cashierId      String        @db.Uuid
  businessDayId  String?       @db.Uuid
  cashierShiftId String?       @db.Uuid
  subtotal       Decimal       @db.Decimal(10, 2)
  gstAmount      Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0.00) @db.Decimal(10, 2)
  grandTotal     Decimal       @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(PENDING)
  orderStatus    OrderStatus   @default(DRAFT)
  businessDate   DateTime      @db.Date
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?
  cancelledAt    DateTime?
  customerId     String?       @db.Uuid
  idempotencyKey String?       @unique @db.VarChar(100)
  orderItems     OrderItem[]
  businessDay    BusinessDay?  @relation(fields: [businessDayId], references: [id], onDelete: Restrict)
  cashier        User          @relation(fields: [cashierId], references: [id])
  cashierShift   CashierShift? @relation(fields: [cashierShiftId], references: [id], onDelete: Restrict)
  customer       Customer?     @relation(fields: [customerId], references: [id])
  payment        Payment?

  @@unique([tokenNumber, businessDate])
  @@index([orderNumber])
  @@index([tokenNumber])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([businessDate])
  @@index([createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  menuItemId String   @db.Uuid
  itemName   String   @db.VarChar(100)
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  gst        Decimal  @db.Decimal(5, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  itemType   ItemType
  notes      String?  @db.VarChar(255)
  createdAt  DateTime @default(now())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@index([createdAt])
  @@map("order_items")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  orderId              String        @unique @db.Uuid
  paymentMethod        PaymentMethod
  amount               Decimal       @db.Decimal(10, 2)
  transactionReference String?       @db.VarChar(100)
  status               PaymentStatus @default(PENDING)
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  order                Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model RestaurantSettings {
  id              String   @id @default(uuid()) @db.Uuid
  restaurantName  String   @db.VarChar(100)
  address         String   @db.VarChar(255)
  phone           String   @db.VarChar(20)
  email           String   @db.VarChar(100)
  gstNumber       String   @db.VarChar(20)
  currency        String   @default("INR") @db.VarChar(10)
  timezone        String   @default("Asia/Kolkata") @db.VarChar(50)
  logo            String?  @db.VarChar(255)
  receiptFooter   String?  @db.VarChar(255)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  city            String?  @db.VarChar(100)
  country         String?  @db.VarChar(100)
  latitude        Decimal? @db.Decimal(10, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  temperatureUnit String   @default("C") @db.VarChar(1)
  weatherEnabled  Boolean  @default(true)
  state           String?  @db.VarChar(100)
  upiId           String?  @db.VarChar(50)
  upiName         String?  @db.VarChar(100)

  @@map("restaurant_settings")
}

model TokenCounter {
  id           String   @id @default(uuid()) @db.Uuid
  businessDate DateTime @unique @db.Date
  currentToken Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessDate])
  @@map("token_counters")
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @db.Uuid
  action      AuditAction
  entity      String      @db.VarChar(50)
  entityId    String?     @db.VarChar(50)
  description String      @db.VarChar(255)
  ipAddress   String?     @db.VarChar(45)
  userAgent   String?     @db.VarChar(255)
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  token      String    @unique
  deviceName String?   @db.VarChar(100)
  browser    String?   @db.VarChar(100)
  ipAddress  String?   @db.VarChar(45)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  loginTime       DateTime  @default(now())
  logoutTime      DateTime?
  device          String?   @db.VarChar(100)
  browser         String?   @db.VarChar(100)
  operatingSystem String?   @db.VarChar(100)
  ipAddress       String?   @db.VarChar(45)
  status          String    @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("user_sessions")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  username      String   @db.VarChar(50)
  ipAddress     String   @db.VarChar(45)
  status        String   @db.VarChar(20)
  failureReason String?  @db.VarChar(255)
  createdAt     DateTime @default(now())

  @@index([username])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

model Terminal {
  id               String         @id @default(uuid()) @db.Uuid
  terminalCode     String         @unique @db.VarChar(50)
  terminalName     String         @db.VarChar(100)
  location         String?        @db.VarChar(100)
  deviceId         String?        @db.VarChar(100)
  status           String         @default("OFFLINE") @db.VarChar(20)
  lastHeartbeat    DateTime?
  receiptPrinterId String?        @db.Uuid
  kitchenPrinterId String?        @db.Uuid
  backupPrinterId  String?        @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  cashDrawer       CashDrawer?
  shifts           CashierShift[]
  backupPrinter    Printer?       @relation("BackupPrinter", fields: [backupPrinterId], references: [id])
  kitchenPrinter   Printer?       @relation("KitchenPrinter", fields: [kitchenPrinterId], references: [id])
  receiptPrinter   Printer?       @relation("ReceiptPrinter", fields: [receiptPrinterId], references: [id])

  @@map("terminals")
}

model CashierShift {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  terminalId     String       @db.Uuid
  businessDayId  String?      @db.Uuid
  openingTime    DateTime     @default(now())
  closingTime    DateTime?
  openingCash    Decimal      @db.Decimal(10, 2)
  closingCash    Decimal?     @db.Decimal(10, 2)
  cashDifference Decimal?     @db.Decimal(10, 2)
  status         String       @default("OPEN") @db.VarChar(20)
  notes          String?      @db.VarChar(255)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cashDrawer     CashDrawer?
  businessDay    BusinessDay? @relation(fields: [businessDayId], references: [id], onDelete: Restrict)
  terminal       Terminal     @relation(fields: [terminalId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  orders         Order[]

  @@map("cashier_shifts")
}

model BusinessDay {
  id           String         @id @default(uuid()) @db.Uuid
  businessDate DateTime       @unique @db.Date
  openedBy     String         @db.Uuid
  closedBy     String?        @db.Uuid
  openedAt     DateTime       @default(now())
  closedAt     DateTime?
  status       String         @default("OPEN") @db.VarChar(20)
  shifts       CashierShift[]
  orders       Order[]

  @@map("business_days")
}

model Printer {
  id              String     @id @default(uuid()) @db.Uuid
  printerName     String     @db.VarChar(100)
  printerType     String     @db.VarChar(50)
  ipAddress       String?    @db.VarChar(45)
  port            Int?       @default(9100)
  paperWidth      String     @default("80mm") @db.VarChar(10)
  location        String     @db.VarChar(100)
  status          String     @default("ONLINE") @db.VarChar(20)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  backupTerminal  Terminal[] @relation("BackupPrinter")
  kitchenTerminal Terminal[] @relation("KitchenPrinter")
  receiptTerminal Terminal[] @relation("ReceiptPrinter")

  @@map("printers")
}

model CashDrawer {
  id                     String            @id @default(uuid()) @db.Uuid
  terminalId             String            @unique @db.Uuid
  cashierShiftId         String?           @unique @db.Uuid
  drawerCode             String            @unique @db.VarChar(50)
  openingBalance         Decimal           @db.Decimal(10, 2)
  currentBalance         Decimal           @db.Decimal(10, 2)
  expectedClosingBalance Decimal           @db.Decimal(10, 2)
  actualClosingBalance   Decimal?          @db.Decimal(10, 2)
  difference             Decimal?          @db.Decimal(10, 2)
  status                 String            @default("CLOSED") @db.VarChar(20)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  events                 CashDrawerEvent[]
  cashierShift           CashierShift?     @relation(fields: [cashierShiftId], references: [id])
  terminal               Terminal          @relation(fields: [terminalId], references: [id])

  @@map("cash_drawers")
}

model CashDrawerEvent {
  id           String     @id @default(uuid()) @db.Uuid
  cashDrawerId String     @db.Uuid
  userId       String?    @db.Uuid
  eventType    String     @db.VarChar(50)
  amount       Decimal?   @db.Decimal(10, 2)
  reason       String?    @db.VarChar(255)
  createdAt    DateTime   @default(now())
  cashDrawer   CashDrawer @relation(fields: [cashDrawerId], references: [id], onDelete: Cascade)

  @@index([cashDrawerId])
  @@map("cash_drawer_events")
}

model InventoryCategory {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique @db.VarChar(100)
  description String?      @db.VarChar(255)
  color       String?      @db.VarChar(20)
  status      String       @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  ingredients Ingredient[]

  @@map("inventory_categories")
}

model Vendor {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(100)
  contactPerson  String?         @db.VarChar(100)
  email          String?         @db.VarChar(100)
  phone          String?         @db.VarChar(20)
  gstNumber      String?         @db.VarChar(50)
  address        String?         @db.VarChar(255)
  status         String          @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("vendors")
}

model Ingredient {
  id            String            @id @default(uuid()) @db.Uuid
  categoryId    String            @db.Uuid
  name          String            @unique @db.VarChar(100)
  sku           String            @unique @db.VarChar(50)
  barcode       String?           @unique @db.VarChar(100)
  unit          String            @db.VarChar(20)
  currentStock  Decimal           @default(0.00) @db.Decimal(10, 3)
  minStock      Decimal           @default(0.00) @db.Decimal(10, 3)
  maxStock      Decimal?          @db.Decimal(10, 3)
  reorderLevel  Decimal?          @db.Decimal(10, 3)
  costPerUnit   Decimal           @default(0.00) @db.Decimal(10, 2)
  image         String?           @db.VarChar(255)
  status        String            @default("ACTIVE") @db.VarChar(20)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  category      InventoryCategory @relation(fields: [categoryId], references: [id])
  purchaseItems PurchaseItem[]
  movements     StockMovement[]

  @@index([categoryId])
  @@index([name])
  @@map("ingredients")
}

model PurchaseOrder {
  id           String         @id @default(uuid()) @db.Uuid
  poNumber     String         @unique @db.VarChar(50)
  vendorId     String         @db.Uuid
  status       String         @default("PENDING") @db.VarChar(20)
  totalAmount  Decimal        @default(0.00) @db.Decimal(12, 2)
  expectedDate DateTime?      @db.Date
  receivedDate DateTime?      @db.Date
  notes        String?        @db.VarChar(255)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        PurchaseItem[]
  vendor       Vendor         @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([poNumber])
  @@map("purchase_orders")
}

model PurchaseItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  ingredientId    String        @db.Uuid
  quantity        Decimal       @db.Decimal(10, 3)
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([ingredientId])
  @@map("purchase_items")
}

model StockMovement {
  id           String     @id @default(uuid()) @db.Uuid
  ingredientId String     @db.Uuid
  type         String     @db.VarChar(20)
  quantity     Decimal    @db.Decimal(10, 3)
  reason       String?    @db.VarChar(255)
  referenceId  String?    @db.VarChar(50)
  createdAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([ingredientId])
  @@index([type])
  @@map("stock_movements")
}

model Customer {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @db.VarChar(100)
  mobileNumber String               @unique @db.VarChar(20)
  email        String?              @db.VarChar(100)
  dateOfBirth  DateTime?            @db.Date
  anniversary  DateTime?            @db.Date
  gender       String?              @db.VarChar(20)
  address      String?              @db.VarChar(255)
  gstNumber    String?              @db.VarChar(50)
  status       String               @default("ACTIVE") @db.VarChar(20)
  notes        String?              @db.VarChar(255)
  totalPoints  Decimal              @default(0.00) @db.Decimal(10, 2)
  rewardTier   String               @default("BRONZE") @db.VarChar(20)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  transactions LoyaltyTransaction[]
  orders       Order[]

  @@index([mobileNumber])
  @@index([name])
  @@map("customers")
}

model LoyaltyTransaction {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  orderId    String?  @db.VarChar(50)
  type       String   @db.VarChar(20)
  points     Decimal  @db.Decimal(10, 2)
  reason     String?  @db.VarChar(255)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([type])
  @@map("loyalty_transactions")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  title      String    @db.VarChar(150)
  message    String
  type       String    @db.VarChar(50)
  priority   String    @default("MEDIUM") @db.VarChar(20)
  userId     String?   @db.Uuid
  roleId     String?   @db.Uuid
  isRead     Boolean   @default(false)
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@index([userId])
  @@index([roleId])
  @@index([isRead])
  @@map("notifications")
}

model NotificationPreference {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  receiveSystem    Boolean  @default(true)
  receiveInventory Boolean  @default(true)
  receiveKitchen   Boolean  @default(true)
  receiveShift     Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("notification_preferences")
}

model SystemBackup {
  id        String   @id @default(uuid()) @db.Uuid
  filename  String   @db.VarChar(255)
  filePath  String   @db.VarChar(500)
  fileSize  BigInt?
  status    String   @default("PENDING") @db.VarChar(20)
  createdBy String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("system_backups")
}

model LicenseKey {
  id          String    @id @default(uuid()) @db.Uuid
  licenseKey  String    @unique @db.VarChar(255)
  status      String    @default("INACTIVE") @db.VarChar(20)
  features    String?
  expiresAt   DateTime?
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("license_keys")
}

model RecoveryKey {
  id          String    @id @default(uuid()) @db.Uuid
  keyHash     String    @db.VarChar(255)
  label       String    @db.VarChar(50)
  createdBy   String    @db.Uuid
  usedAt      DateTime?
  isRevoked   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([keyHash])
  @@map("recovery_keys")
}

enum UserRole {
  SUPER_ADMIN
  CASHIER
  MANAGER
}

enum ItemType {
  KITCHEN
  PACKED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OrderStatus {
  DRAFT
  PAID
  PRINTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PRINT
  CANCEL
}
